# Copy to .env (gitignored) — or run `cargo run -p blinker-cli -- setup`,
# which generates wallets in .keys/ and writes .env for you.

DATABASE_URL=postgres://localhost:5432/blinker

# localnet (solana-test-validator) | devnet | mainnet
SOLANA_CLUSTER=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
# SOLANA_WS_URL is derived from the RPC URL when unset.

# Public key that receives the 0.001 SOL activation fee.
TREASURY_PUBKEY=
PUBLIC_URL=http://localhost:3000

# Optional tuning
# BLINK_FEE_LAMPORTS=1000000
# DATA_DIR=data
# EVENT_QUEUE_CAPACITY=8192
# EVENT_LOG_SYNC=every          # every | never | <millis>
# EVENT_LOG_SEGMENT_BYTES=16777216
# VERIFY_WORKERS=4
# RUST_LOG=info,blinker_server=debug
